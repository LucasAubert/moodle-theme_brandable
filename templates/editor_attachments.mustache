{{!
    @template theme_brandable/editor_attachments

    Images attached to the next prompt (their thumbnail is sent with it).

    Context variables required for this template:
    * attachments - List of {id, slug, thumbnailurl, url}

    Example context (json):
    {
        "attachments": [{"id": 1, "slug": "logo-universite", "thumbnailurl": "https://example.com/t.png", "url": "https://example.com/a.png"}]
    }
}}
{{#attachments}}
<span class="tbe-attachment" data-region="attachment" data-slug="{{slug}}">
    {{#thumbnailurl}}<img src="{{thumbnailurl}}" alt="">{{/thumbnailurl}}{{^thumbnailurl}}<img src="{{url}}" alt="">{{/thumbnailurl}}
    <span>{{slug}}</span>
    <button type="button" class="tbe-iconbtn" data-action="detachasset" data-id="{{id}}" title="{{#str}} assets:detach, theme_brandable, {{slug}} {{/str}}" aria-label="{{#str}} assets:detach, theme_brandable, {{slug}} {{/str}}">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
    </button>
</span>
{{/attachments}}
