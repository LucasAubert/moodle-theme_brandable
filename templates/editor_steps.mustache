{{!
    @template theme_brandable/editor_steps

    Folded steps of a generation: events grouped by attempt (run 0: generation, 1..n: repairs), including the
    changes rejected by the plugin validation. Messages come from the generator and are shown as is (escaped).

    Context variables required for this template:
    * hassteps - Whether there are steps to show
    * runs - Attempts: label, events (message, isrejected)

    Example context (json):
    {
        "hassteps": true,
        "runs": [
            {"label": "Generation", "events": [{"message": "Planning the changes", "isrejected": false}]},
            {"label": "Repair 1", "events": [{"message": "Fixing the rejected changes", "isrejected": false}]}
        ]
    }
}}
{{#hassteps}}
    <details class="tbe-steps">
        <summary>{{#str}} showsteps, theme_brandable {{/str}}</summary>
        {{#runs}}
            <div class="tbe-run">
                <div class="tbe-run-label">{{label}}</div>
                <ul class="tbe-events">
                    {{#events}}
                        <li class="{{#isrejected}}is-rejected{{/isrejected}}">{{message}}</li>
                    {{/events}}
                </ul>
            </div>
        {{/runs}}
    </details>
{{/hassteps}}
