{{!
    @template theme_brandable/editor_cloudpropose

    Body of the dialog proposing a version of the project to another environment (spec C15).

    Context variables required for this template:
    * environments - Other environments of the project: id, name
    * maxlength - Longest message

    Example context (json):
    {
        "environments": [{"id": "e-prod", "name": "Production"}],
        "maxlength": 500
    }
}}
<p>{{#str}} cloud:propose:intro, theme_brandable {{/str}}</p>
<label class="d-block">{{#str}} cloud:propose:environment, theme_brandable {{/str}}
    <select class="form-select custom-select d-block w-100 mt-1" data-region="proposeenvironment">
        {{#environments}}<option value="{{id}}">{{name}}</option>{{/environments}}
    </select>
</label>
<label class="d-block mt-2">{{#str}} cloud:propose:message, theme_brandable {{/str}}
    <textarea class="form-control mt-1" rows="3" maxlength="{{maxlength}}" data-region="proposemessage"></textarea>
</label>
