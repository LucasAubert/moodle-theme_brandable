{{!
    @template theme_brandable/editor_outdatedtemplates

    Template overrides made from another version of their original (the parent theme or Moodle changed since), to be
    reviewed (theme_brandable\local\overrides\outdated).

    Context variables required for this template:
    * outdated - Template names

    Example context (json):
    {
        "outdated": ["block_myoverview/main", "core/navbar"]
    }
}}
<div class="tbe-proposal tbe-parentnotices" data-region="outdatedtemplates" role="status">
    <div class="tbe-jsreview-title"><strong>{{#str}} outdatedtemplates, theme_brandable {{/str}}</strong></div>
    <p class="mb-1">{{#str}} outdatedtemplates_desc, theme_brandable {{/str}}</p>
    <ul>
        {{#outdated}}<li><code>{{.}}</code></li>{{/outdated}}
    </ul>
</div>
