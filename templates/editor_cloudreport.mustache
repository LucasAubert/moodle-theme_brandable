{{!
    @template theme_brandable/editor_cloudreport

    Report of a restoration or a pull (spec C9 to C13): what was left out of the draft, the files downloaded, renamed
    or refused, the findings of Brandable. Plain text only.

    Context variables required for this template:
    * number - Number of the version
    * removed - [{target, reason}]; blocked - targets; renamed - [{from, to}]; refused - [{slug, message}]
    * downloaded - Files downloaded; findings - [{code, severity, target, message, blocking}]

    Example context (json):
    {
        "number": 12, "hasremoved": true, "removed": [{"target": "post/course", "reason": "No such course here."}],
        "hasblocked": false, "blocked": "", "downloaded": 2, "hasrenamed": false, "renamed": "",
        "hasrefused": false, "refused": "", "hasfindings": true,
        "findings": [{"code": "template_source_changed", "severity": "warning", "target": "core/navbar",
            "message": "The original template differs.", "blocking": false}]
    }
}}
<p>{{#str}} cloud:report:done, theme_brandable, {{number}} {{/str}}</p>
{{#hasremoved}}
    <p class="mb-1">{{#str}} cloud:report:removed, theme_brandable {{/str}}</p>
    <ul>{{#removed}}<li><code>{{target}}</code> : {{reason}}</li>{{/removed}}</ul>
{{/hasremoved}}
{{#hasblocked}}<p class="text-danger">{{#str}} cloud:report:blocked, theme_brandable, {{blocked}} {{/str}}</p>{{/hasblocked}}
{{#downloaded}}<p>{{#str}} cloud:report:downloaded, theme_brandable, {{downloaded}} {{/str}}</p>{{/downloaded}}
{{#hasrenamed}}<p>{{#str}} cloud:report:renamed, theme_brandable, {{renamed}} {{/str}}</p>{{/hasrenamed}}
{{#hasrefused}}<p class="text-danger">{{#str}} cloud:report:refused, theme_brandable, {{refused}} {{/str}}</p>{{/hasrefused}}
{{#hasfindings}}
    <p class="mb-1">{{#str}} cloud:report:findings, theme_brandable {{/str}}</p>
    <ul>{{#findings}}<li{{#blocking}} class="text-danger"{{/blocking}}>{{#target}}<code>{{target}}</code> : {{/target}}{{message}}</li>{{/findings}}</ul>
{{/hasfindings}}
