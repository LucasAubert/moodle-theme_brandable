{{!
    @template theme_brandable/preview_banner

    Discreet banner shown on every page of a session in preview mode.

    Context variables required for this template:
    * revision - Previewed revision id
    * exiturl - URL leaving the preview mode

    Example context (json):
    {
        "revision": 12,
        "exiturl": "https://example.com/theme/brandable/preview.php?sesskey=abc"
    }
}}
<div class="theme-brandable-preview-banner" role="status" data-region="theme-brandable-preview-banner">
    <span class="theme-brandable-preview-banner-dot" aria-hidden="true"></span>
    <span>{{#str}} previewbanner, theme_brandable, {{revision}} {{/str}}</span>
    <a href="{{exiturl}}" target="_top" class="theme-brandable-preview-banner-exit">{{#str}} exitpreview, theme_brandable {{/str}}</a>
</div>
<style>
    /* Sober pill (spec of the brand, E12): surface and text of Moodle (they follow the mode), chartreuse dot. */
    .theme-brandable-preview-banner {
        position: fixed;
        left: 12px;
        bottom: 12px;
        z-index: 2000;
        display: flex;
        align-items: center;
        padding: 4px 4px 4px 12px;
        border: 1px solid var(--bs-border-color, #dee2e6);
        border-radius: 10px;
        background: var(--bs-body-bg, #fff);
        color: var(--bs-body-color, #1d2125);
        font-size: 12px;
        line-height: 1.6;
    }
    .theme-brandable-preview-banner-dot {
        width: 10px;
        height: 10px;
        margin-right: 8px;
        border: 1px solid #15171c;
        border-radius: 50%;
        background: #d4f25a;
    }
    .theme-brandable-preview-banner .theme-brandable-preview-banner-exit {
        display: inline-flex;
        align-items: center;
        min-height: 32px;
        margin-left: 10px;
        padding: 0 10px;
        border-radius: 6px;
        background: var(--bs-secondary-bg, #e9ecef);
        color: var(--bs-body-color, #1d2125);
        text-decoration: none;
    }
    .theme-brandable-preview-banner .theme-brandable-preview-banner-exit:hover {
        text-decoration: underline;
    }
    .theme-brandable-preview-banner .theme-brandable-preview-banner-exit:focus-visible {
        outline: 2px solid var(--bs-body-color, #1d2125);
        outline-offset: 2px;
    }
</style>
