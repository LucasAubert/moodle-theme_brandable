{{!
    @template theme_brandable/editor_billingcountry

    Billing country asked before the first purchase of the organisation (sent with the purchase).

    Context variables required for this template:
    * countries - Countries ({code, name, selected})

    Example context (json):
    {
        "countries": [{"code": "BE", "name": "Belgique", "selected": false}, {"code": "FR", "name": "France", "selected": true}]
    }
}}
<div class="tbe-billingcountry">
    <label class="tbe-hint d-block mb-0">{{#str}} account:billingcountry, theme_brandable {{/str}}
    <select class="custom-select form-select form-select-sm" data-region="billingcountry">
        <option value="">{{#str}} account:choosecountry, theme_brandable {{/str}}</option>
        {{#countries}}
            <option value="{{code}}"{{#selected}} selected{{/selected}}>{{name}}</option>
        {{/countries}}
    </select>
    </label>
    <div class="tbe-hint">{{#str}} account:billingcountry_help, theme_brandable {{/str}}</div>
</div>
