{{!
    @template theme_brandable/editor_parentnotices

    What the parent theme applies after Brandable, while its setting is on: its custom CSS, its own dark mode
    (theme_brandable\local\parent_notices).

    Context variables required for this template:
    * notices - [{key, text}] (theme_brandable\local\parent_notices::get())

    Example context (json):
    {
        "notices": [{"key": "customcss", "text": "The custom CSS of the parent theme is added after the changes of Brandable."}]
    }
}}
<div class="tbe-proposal tbe-parentnotices" data-region="parentnotices" role="status">
    <div class="tbe-jsreview-title"><strong>{{#str}} parentnotices, theme_brandable {{/str}}</strong></div>
    <ul>
        {{#notices}}<li data-notice="{{key}}">{{text}}</li>{{/notices}}
    </ul>
</div>
